<mxCell id="e90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d62728;fontColor=#d62728;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1152" y="285"/><mxPoint x="1031" y="285"/></Array></mxGeometry></mxCell>
<mxCell id="e91" value="Active failover · health check /healthz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d62728;fontColor=#d62728;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c61"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1152" y="285"/><mxPoint x="1561" y="285"/></Array></mxGeometry></mxCell>
<mxCell id="e92" value="TCP 5432 · health check&lt;br&gt;HAProxy → Patroni /primary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d62728;fontColor=#d62728;" edge="1" parent="1" source="c23" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e93" value="TCP 5432 · health check&lt;br&gt;HAProxy → Patroni /primary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d62728;fontColor=#d62728;" edge="1" parent="1" source="c43" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e94" value="TCP 5432 · health check&lt;br&gt;HAProxy → Patroni /primary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;strokeColor=#d62728;fontColor=#d62728;" edge="1" parent="1" source="c63" target="c70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e95" value="синхронная&lt;br&gt;репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2875E2;fontColor=#2875E2;strokeWidth=2;" edge="1" parent="1" source="c30" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e96" value="асинхронная репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2875E2;fontColor=#2875E2;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c30" target="c70"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="940"/><mxPoint x="1390" y="940"/></Array></mxGeometry></mxCell>
<mxCell id="e97" value="WAL-G: WAL + base backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#2875E2;fontColor=#2875E2;strokeWidth=2;exitX=0;exitY=0.5;" edge="1" parent="1" source="c30" target="c76"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="790"/><mxPoint x="60" y="1042"/></Array></mxGeometry></mxCell>
<mxCell id="c98" value="&lt;b&gt;1. Масштабирование и отказоустойчивость&lt;/b&gt;&lt;br&gt;Сервисы - горизонтально: HPA + Cluster Autoscaler.&lt;br&gt;БД - вертикально + реплики на чтение.&lt;br&gt;3 зоны доступности, утилизация ≤ 60%: при отказе зоны 2 оставшиеся держат нагрузку.&lt;br&gt;Статика через CDN, API через ALB - одинаковое время загрузки из регионов." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="40" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="c99" value="&lt;b&gt;2a. Kubernetes: независимый кластер в каждой зоне&lt;/b&gt;&lt;br&gt;Отказ или обновление одного кластера не затрагивает остальные; у растянутого кластера общий control plane и etcd - единая точка отказа.&lt;br&gt;Разовые задачи (ins-comp-settlement) - под pg_advisory_lock." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="210" width="440" height="130" as="geometry"/></mxCell>
<mxCell id="c100" value="&lt;b&gt;2b. Балансировка и health check&lt;/b&gt;&lt;br&gt;ALB (L7) → ingress зон: /healthz каждые 5 c, 3 ошибки - зона выводится.&lt;br&gt;Поды: readiness/liveness probes.&lt;br&gt;HAProxy → Patroni: /primary (запись), /replica (чтение)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="360" width="440" height="130" as="geometry"/></mxCell>
<mxCell id="c101" value="&lt;b&gt;2c. Фейловер: Active-Active&lt;/b&gt;&lt;br&gt;Доступность 99,9% ≥ 99,5% → Active-Active.&lt;br&gt;Клиент → DNS → ALB → все зоны; при отказе зоны ALB по health check выводит её из балансировки." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="510" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="c102" value="&lt;b&gt;2d. БД: PostgreSQL + Patroni + etcd (3 узла)&lt;/b&gt;&lt;br&gt;Leader (a) → синхронная реплика (b): RPO ≈ 0.&lt;br&gt;Асинхронная реплика (d): чтение.&lt;br&gt;Автоматический failover Patroni ≈ 30 c &amp;lt; RTO 45 мин.&lt;br&gt;WAL-G в Object Storage: WAL каждую минуту, base backup раз в сутки - RPO ≤ 1 мин &amp;lt; 15 мин." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="640" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="c103" value="&lt;b&gt;3. Шардирование: нет&lt;/b&gt;&lt;br&gt;50 GB помещаются на один узел; нагрузка на чтение - реплики." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="810" width="440" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
