<mxCell id="c42" value="Circuit Breaker" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2140" y="517" width="74" height="16" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b&gt;Event Streaming (Kafka)&lt;/b&gt;&lt;br&gt;• TariffChanged → products.tariffs, ключ productId (compacted).&lt;br&gt;• PolicyIssued → policies.issued, ключ policyId.&lt;br&gt;• Потребители идемпотентны: дедупликация по eventId.&lt;br&gt;• Ошибки обработки: retry, DLQ; мониторинг consumer lag.&lt;br&gt;• Убраны REST-вызовы core-app и ins-comp-settlement к ins-product-aggregator и ночная выгрузка из core-app." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2620" y="260" width="460" height="200" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b&gt;Transactional Outbox: да&lt;/b&gt;&lt;br&gt;Сервис сохраняет событие в outbox в одной транзакции с данными; Debezium читает лог транзакций и публикует в Kafka." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2620" y="480" width="460" height="110" as="geometry"/></mxCell>
<mxCell id="c45" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;Зелёный - новые элементы, серый - без изменений." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2620" y="610" width="460" height="70" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
